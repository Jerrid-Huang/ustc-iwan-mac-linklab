diff --git a/CMakeLists.txt b/CMakeLists.txt
index d604195..c386b56 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -394,6 +394,15 @@ target_link_libraries(iwan-client PRIVATE iwan_core)
 add_executable(iwan-client-oidc src/iwan_client_oidc.c)
 target_link_libraries(iwan-client-oidc PRIVATE iwan_oidc)
 
+if(APPLE)
+  # Keychain branch: SecItem* from Security, CF* helpers from CoreFoundation.
+  # SHELL: keeps each "-framework X" as its own single argument and stops
+  # CMake from translating the framework names into -lSecurity / -lCoreFoundation.
+  target_link_options(iwan-client-oidc PRIVATE
+    "SHELL:-framework Security"
+    "SHELL:-framework CoreFoundation")
+endif()
+
 # SOCKS5 handshake test harness (root-free: drives the real accept/handshake/
 # netstack code with a loopback listener; see tests/socks_handshake.py).
 # Built only when testing is enabled so release binaries don't ship it.
diff --git a/src/oidc/oidc_pwsecret.c b/src/oidc/oidc_pwsecret.c
index 48856e5..7a85d44 100644
--- a/src/oidc/oidc_pwsecret.c
+++ b/src/oidc/oidc_pwsecret.c
@@ -104,6 +104,77 @@ char *oidc_unwrap_password(const char *stored, const char *domain,
         return pw_hex_decode_wdp(stored + 5);
     return xstrdup(stored);
 }
+#elif defined(__APPLE__)
+#include <Security/Security.h>
+
+/* "WKC1" marker: the real blob lives in the login Keychain under
+ * service "ustc-iwan-c" / account "domain|user". */
+static CFStringRef pw_acc(const char *domain, const char *user)
+{
+    char acc[512];
+    snprintf(acc, sizeof acc, "%s|%s", domain ? domain : "",
+             user ? user : "");
+    return CFStringCreateWithCString(kCFAllocatorDefault, acc,
+                                     kCFStringEncodingUTF8);
+}
+
+char *oidc_wrap_password(const char *blob, const char *domain,
+                         const char *user)
+{
+    CFStringRef acc = pw_acc(domain, user);
+    CFDataRef data = CFDataCreate(kCFAllocatorDefault,
+                                  (const UInt8 *)blob,
+                                  (CFIndex)strlen(blob) + 1);
+    if (!data) {
+        CFRelease(acc);
+        return NULL;
+    }
+    const void *keys[] = { kSecClass, kSecAttrService, kSecAttrAccount,
+                           kSecValueData };
+    const void *vals[] = { kSecClassGenericPassword,
+                           CFSTR("ustc-iwan-c-pwsecret"), acc, data };
+    CFDictionaryRef d = CFDictionaryCreate(
+        kCFAllocatorDefault, keys, vals, 4,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    SecItemDelete(d);   /* idempotent save */
+    OSStatus st = SecItemAdd(d, NULL);
+    CFRelease(d);
+    CFRelease(data);
+    CFRelease(acc);
+    return st == errSecSuccess ? xstrdup("WKC1") : NULL;
+}
+
+char *oidc_unwrap_password(const char *stored, const char *domain,
+                           const char *user)
+{
+    if (strncmp(stored, "WKC1", 4) != 0)
+        return xstrdup(stored);
+    CFStringRef acc = pw_acc(domain, user);
+    const void *keys[] = { kSecClass, kSecAttrService, kSecAttrAccount,
+                           kSecReturnData, kSecMatchLimit };
+    const void *vals[] = { kSecClassGenericPassword,
+                           CFSTR("ustc-iwan-c-pwsecret"), acc,
+                           kCFBooleanTrue, kSecMatchLimitOne };
+    CFDictionaryRef d = CFDictionaryCreate(
+        kCFAllocatorDefault, keys, vals, 5,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFTypeRef out = NULL;
+    OSStatus st = SecItemCopyMatching(d, &out);
+    CFRelease(d);
+    CFRelease(acc);
+    if (st != errSecSuccess || !out)
+        return NULL;
+    CFDataRef data = (CFDataRef)out;
+    const UInt8 *p = CFDataGetBytePtr(data);
+    CFIndex n = CFDataGetLength(data);
+    char *res = malloc((size_t)n + 1);
+    if (res) {
+        memcpy(res, p, (size_t)n);
+        res[n] = '\0';
+    }
+    CFRelease(out);
+    return res;
+}
 #else
 /* No per-user OS protection available: keep the legacy app-secret blob
  * (obfuscation-level only; see oidc_pwsecret.h). */
